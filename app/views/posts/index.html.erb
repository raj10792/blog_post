<% content_for :title, "Your posts" %>

<div class="space-y-8">
  <% if notice %>
    <div class="rounded-lg bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700" role="status"><%= notice %></div>
  <% end %>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">Your writing space</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Your posts</h1>
      <p class="mt-2 text-slate-600">Ideas worth sharing, all in one place.</p>
    </div>
    <%= link_to "Write a post", new_post_path, class: "inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700" %>
  </div>

  <% if @posts.any? %>
    <div id="posts" class="grid gap-5 md:grid-cols-2">
      <% @posts.each do |post| %>
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-200 hover:shadow-md">
          <%= render post %>
          <%= link_to "Read post", post, class: "mt-5 inline-flex text-sm font-semibold text-indigo-600 hover:text-indigo-700" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
      <h2 class="text-lg font-semibold text-slate-900">Your first post starts here</h2>
      <p class="mt-2 text-sm text-slate-600">Share a thought, a story, or something you’ve learned.</p>
      <%= link_to "Create your first post", new_post_path, class: "mt-5 inline-flex rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700" %>
    </div>
  <% end %>
</div>
