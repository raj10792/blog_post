<div class="mx-auto w-full max-w-md">
  <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
    <div class="mb-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">Account recovery</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Forgot your password?</h1>
      <p class="mt-2 text-sm text-slate-500">Enter your email and we’ll send you a reset link.</p>
    </div>
    <% if flash[:alert] %>
      <div class="mb-5 rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700" role="alert"><%= flash[:alert] %></div>
    <% end %>
    <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :email_address, "Email address", class: "mb-1.5 block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-slate-900 shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" %>
      </div>
      <%= form.submit "Email reset instructions", class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
    <% end %>
    <p class="mt-6 text-center text-sm text-slate-600"><%= link_to "Back to sign in", new_session_path, class: "font-semibold text-indigo-600 hover:text-indigo-700" %></p>
  </div>
</div>
